# ════════════════════════════════════════════════════════════════════
#  CamerasIA · Centro de Monitoreo de Seguridad — configuración
#  Copie este archivo como .env y complete los valores.
# ════════════════════════════════════════════════════════════════════

NODE_ENV=production
HOST=0.0.0.0
PORT=8443

# ── TLS (HTTPS) ─────────────────────────────────────────────────────
# Genere un certificado con scripts/gen-cert.sh o use uno de su CA interna.
# Rutas para Docker. Instalación sin Docker: ../certs/cert.pem y ../certs/key.pem (relativas a server/).
TLS_CERT_FILE=/certs/cert.pem
TLS_KEY_FILE=/certs/key.pem
# Si publica detrás de un proxy inverso / FortiGate (VIP + SSL offload), use:
# TRUST_PROXY=true
# COOKIE_SECURE=true

# ── Bóveda de credenciales (OBLIGATORIO en producción) ──────────────
# 32 bytes aleatorios en base64:   openssl rand -base64 32
# Guárdela fuera del volumen de datos (gestor de secretos / Docker secret).
# Si la pierde, las credenciales guardadas NO se pueden recuperar.
VAULT_MASTER_KEY=
# Alternativa: ruta a un archivo con la clave
# VAULT_KEY_FILE=/run/secrets/vault_key
# Permitir que un admin (con 2FA) vea un secreto guardado. Recomendado: false
VAULT_ALLOW_REVEAL=false

# ── Usuarios y sesiones ─────────────────────────────────────────────
ADMIN_USERNAME=admin
# Si se deja vacío, se genera una contraseña temporal y se muestra en el log del primer arranque.
ADMIN_INITIAL_PASSWORD=
REQUIRE_2FA=true
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
STEP_UP_MINUTES=5

# ── Modo DEMO ───────────────────────────────────────────────────────
# true = cámaras/eventos simulados para probar la plataforma.
# Pase a false cuando tenga configurados sus servidores exacqVision.
DEMO_MODE=true

# ── FortiVPN (openfortivpn) ─────────────────────────────────────────
# auto        → usa openfortivpn si está instalado; si no, simula
# openfortivpn→ fuerza el cliente real
# simulate    → sólo simulación (pruebas)
# disabled    → el centro corre dentro de la LAN y no necesita túnel
VPN_MODE=auto
OPENFORTIVPN_BIN=openfortivpn
# En la imagen Docker se ejecuta con sudo (sólo ese binario).
VPN_USE_SUDO=true

# ── IA (Claude, de Anthropic) ───────────────────────────────────────
# Recomendado: cargar la API key desde la interfaz (Bóveda → tipo "Anthropic API").
# ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Tope de análisis de imágenes por hora (control de costos).
AI_MAX_ANALYSES_PER_HOUR=120

# ── Integraciones ───────────────────────────────────────────────────
# Endpoint /api/ingest/detections para Frigate, CodeProject.AI, scripts, etc.
INGEST_ENABLED=true

# Orígenes adicionales permitidos (si accede por varios nombres DNS), separados por coma.
# ALLOWED_ORIGINS=https://soc.empresa.com

LOG_LEVEL=info
